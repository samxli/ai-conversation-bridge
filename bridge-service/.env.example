# Orchestrator: flowise (default) | langgraph | direct_llm
ORCHESTRATOR=flowise
# Deprecated aliases (still honored when ORCHESTRATOR is unset):
# AI_PROVIDER=flowise
# CHAT_PROVIDER=flowise

# ─── LINE WORKS ───────────────────────────────────────────────
LW_API_20_CLIENT_ID=
LW_API_20_CLIENT_SECRET=
LW_API_20_SERVICE_ACCOUNT_ID=
LW_API_20_PRIVATEKEY=
LW_API_20_BOT_ID=
LW_API_20_BOT_SECRET=

# ─── DingTalk HTTP Robot ─────────────────────────────────────
# Comma-separated DingTalk senderStaffId values allowed to use the bot.
# These are the admin-console employee UserID values, not encrypted senderId values.
# Leave DINGTALK_ALLOW_ALL_USERS=false in production unless access is controlled elsewhere.
DINGTALK_ALLOWED_USERS=
DINGTALK_ALLOW_ALL_USERS=false
DINGTALK_REQUIRE_MENTION=true
DINGTALK_GROUP_SESSIONS_PER_USER=true

# ─── Flowise (ORCHESTRATOR=flowise) ───────────────────────────
# Full prediction endpoint URL, e.g. https://your-flowise.com/api/v1/prediction/<flow-id>
FLOWISE_API_URL=
FLOWISE_API_KEY=
FLOWISE_TIMEOUT=120

# ─── LLM (ORCHESTRATOR=direct_llm or langgraph) ───────────────
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.2
# Leave unset on LangGraph to keep the bundled Workday prompt (datetime is
# always appended). Direct LLM falls back to "You are a helpful assistant."
# LLM_SYSTEM_PROMPT=
# Last N messages kept in the LangGraph window (Flowise agentMemoryWindowSize).
LLM_MESSAGE_WINDOW=20
# Options: high, medium, low, minimal, none (OpenRouter-shaped; some models ignore)
LLM_REASONING_EFFORT=
# Deprecated OpenRouter aliases (still honored as fallbacks):
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_SYSTEM_PROMPT=You are a helpful assistant.
# OPENROUTER_REASONING_EFFORT=

# ─── LangGraph (ORCHESTRATOR=langgraph) ───────────────────────
STATE_BACKEND=memory
MCP_SERVER_URL=
# Optional, e.g. "Bearer <token>" or a raw token
MCP_AUTH_HEADER=
# Optional comma-separated tool names. Leave unset for the built-in safe
# allowlist. Set to "*" only when intentionally allowing every discovered tool.
# Names the MCP server does not expose fail startup.
# MCP_TOOL_ALLOWLIST=find_employee_id_by_name,get_current_user_info
# Must stay below gunicorn --timeout (300)
ORCHESTRATOR_TIMEOUT=240

# ─── App ──────────────────────────────────────────────────────
PORT=8080
